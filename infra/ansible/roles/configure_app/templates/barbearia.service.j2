# =============================================================================
# barbearia.service — GERADO AUTOMATICAMENTE pelo Ansible
# -----------------------------------------------------------------------------
# Template: infra/ansible/roles/configure_app/templates/barbearia.service.j2
# Instalado em: /etc/systemd/system/barbearia.service
# =============================================================================
[Unit]
Description=Sistema Barbearia - Spring Boot Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_home }}
ExecStart=/usr/bin/java -jar {{ app_home }}/{{ app_jar }}
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
